APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_intel
REDIS_URL=redis://localhost:6379/0
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GITHUB_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY_1=
